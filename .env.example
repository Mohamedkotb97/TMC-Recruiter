# ============================================================
#  TMC Recruiter — environment variables
#  Copy to `.env` for local dev, or paste each variable into the
#  host's env settings page (Render / Railway / Fly dashboard).
# ============================================================

# --- REQUIRED ---

# Claude key — powers AI briefs + reply drafts + sentiment.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Admin fallback key (ONLY used for server-to-server admin tooling like
# /api/admin/purge). The Chrome extension NO LONGER accepts this key — each
# recruiter now logs into the dashboard and copies their personal tmc_… key
# from Settings → Chrome Extension.
CRM_API_KEY=choose-any-long-random-string-here

# Database URL. Leave the SQLite default for local dev.
# For production: Supabase gives you a free Postgres — copy the connection
# string from Project Settings → Database → Connection string → URI tab,
# then add `+psycopg` right after `postgresql`:
#   postgresql+psycopg://postgres.<proj>:PASSWORD@aws-0-<region>.pooler.supabase.com:6543/postgres
# Neon, Railway, Fly Postgres all work the same way.
DATABASE_URL=sqlite:///./recruiter.db


# --- RECOMMENDED IN PRODUCTION ---

# Comma-separated list of origins that can hit the API. The Chrome extension
# origin (chrome-extension://<id>) is always allowed automatically. Set this
# to lock out random websites from using your backend.
#   ALLOWED_ORIGINS=https://recruiter.tmc.com,https://staging.tmc.com
# Leave as "*" for local dev.
ALLOWED_ORIGINS=*

# Default admin password — only used on the FIRST boot, when the DB is
# empty. After that first login, change it from the UI.
DEFAULT_ADMIN_PASSWORD=tmc-admin

# Port. Most PaaS set this automatically.
PORT=8000


# --- OPTIONAL ---

# Set to 1 on serverless hosts where the process dies between requests
# (Vercel Python, AWS Lambda). The in-process background worker becomes a
# no-op and briefs are generated on-demand when the recruiter opens a
# conversation in the dashboard. Leave OFF on Render / Railway / Fly / Docker.
DISABLE_BG_ANALYSIS=0

# Integrations below are stored IN THE DATABASE via the Settings UI (so each
# deployment can connect to a different tenant), not via env vars. You can
# still pre-seed them by logging in and pasting into Settings.
#   Apify     — profile enrichment (replaces Proxycurl)
#   Unipile   — alternative LinkedIn messaging ingest
#   Greenhouse / Lever — ATS push
